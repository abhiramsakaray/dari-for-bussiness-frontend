# Force XML files to be served with correct content-type
<FilesMatch "\.(xml)$">
  Header set Content-Type "text/xml; charset=UTF-8"
  Header set X-Content-Type-Options "nosniff"
  Header set Cache-Control "public, max-age=3600, must-revalidate"
</FilesMatch>

# Force text files to be served with correct content-type
<FilesMatch "\.(txt)$">
  Header set Content-Type "text/plain; charset=utf-8"
  Header set X-Content-Type-Options "nosniff"
  Header set Cache-Control "public, max-age=3600, must-revalidate"
</FilesMatch>

# Enable rewrite engine for React Router
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Don't rewrite files or directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  
  # Don't rewrite sitemap.xml, robots.txt, and other static files
  RewriteCond %{REQUEST_URI} !^/sitemap\.xml$
  RewriteCond %{REQUEST_URI} !^/robots\.txt$
  RewriteCond %{REQUEST_URI} !^/favicon\.
  RewriteCond %{REQUEST_URI} !^/.*\.(jpg|jpeg|png|gif|svg|css|js|json|ico|woff|woff2|ttf|eot)$
  
  # Rewrite everything else to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Enable GZIP compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# Set cache control
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
